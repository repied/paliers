// NOTE: this devcontainer seems a bit too comple. It could be good to refactor it by using a proper Docker file as well.
{
	"name": "Jekyll",
	"image": "mcr.microsoft.com/devcontainers/jekyll:1-bullseye",
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "latest"
		}
	},
	"forwardPorts": [
		// Jekyll server
		4000,
		// Live reload server
		35729
	],
	// This copy of binares is needed, not sure why
	"postCreateCommand": "npm install -g typescript http-server || true && mkdir -p /home/vscode/bin && for f in /usr/local/share/nvm/versions/node/*/bin/*; do [ -f \"$f\" ] && ln -sf \"$f\" /home/vscode/bin/$(basename \"$f\"); done",
	"customizations": {
		"vscode": {
			"extensions": [
				"dracula-theme.theme-dracula",
				"earshinov.filter-lines",
				"github.copilot-chat",
				"github.copilot",
				"github.vscode-pull-request-github",
				"github.vscode-github-actions",
				"johnpapa.vscode-peacock",
				"streetsidesoftware.code-spell-checker-french",
				"streetsidesoftware.code-spell-checker",
				"usernamehw.errorlens",
				"wayou.vscode-todo-highlight",
				"wmaurer.vscode-jumpy"
			]
		}
	}
	// "remoteUser": "root"
}
