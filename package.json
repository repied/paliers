{
  "name": "paliers",
  "version": "1.0.0",
  "description": "Client side tool to display scuba diving desaturation plan",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "tsc": "tsc",
    "watch": "webpack --watch",
    "build": "webpack",
    "zip": "zip -r dist/paliers.zip index.html style.css dist/bundle.js favicon.ico favicon.png",
    "test": "jest",
    "serve": "http-server ./"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/repied/paliers.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/repied/paliers/issues"
  },
  "homepage": "https://github.com/repied/paliers#readme",
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "collectCoverageFrom": [
      "src/*.ts"
    ]
  },
  "files": [
    "js",
    "docs",
    "media"
  ],
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "http-server": "^14.1.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1"
  }
}
